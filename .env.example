# Copy this file to ".env" and fill what you need. Every value is OPTIONAL.
# On Vercel add the same names under Project -> Settings -> Environment Variables.

# Online donations (Razorpay "Key Id", starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=

# Forms (contact / volunteer / CSR / newsletter / event registration). Use ONE of these:
# 1) Web3Forms access key (free, https://web3forms.com)  -> mails submissions to you
VITE_WEB3FORMS_KEY=
# 2) Any form endpoint that accepts a JSON POST, e.g. Formspree: https://formspree.io/f/xxxxxxx
VITE_FORM_ENDPOINT=
# If neither is set, forms fall back to opening the visitor's email app addressed to you.

# Live numbers / campaigns / events. Default is the file /data/live.json in this project.
# Point it at any public JSON URL with the same shape to update without redeploying.
VITE_LIVE_DATA_URL=

# Optional privacy-friendly analytics (https://plausible.io). Example: saharangosag.com
VITE_PLAUSIBLE_DOMAIN=

# Document requests and volunteer sign-ups are stored in server/data.db by the site's own server (npm run admin / npm start). No cloud database needed.

# ---------------------------------------------------------------------------
# ADMIN PANEL (/admin) - server-side settings. NEVER prefix these with VITE_ (that would publish them).
# Optional: 32+ random characters. If empty, one is generated once and kept in server/storage/session.secret.
ADMIN_SESSION_SECRET=
ADMIN_PORT=3001
ADMIN_SESSION_HOURS=8
# Set true when served over HTTPS (production). Cookies then get the Secure flag.
COOKIE_SECURE=false
# Set true only behind a reverse proxy you control (rate limits then use X-Forwarded-For).
TRUST_PROXY=false
# Email (your own SMTP account: Gmail app password, Zoho, cPanel mail, ...). Needed to send documents, receipts, broadcasts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sahara Jan Kalyan Samiti <info@saharangosag.com>"
# Razorpay webhook (optional): Dashboard -> Settings -> Webhooks, URL https://YOUR-DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Only if the website is hosted on a different address than the admin server (e.g. site on Vercel, admin on a VPS):
VITE_API_URL=

# ---------------------------------------------------------------------------
# SUPABASE (database + admin login). Find both in Supabase -> Project Settings -> API.
# The URL and the *publishable* key (sb_publishable_...) are safe in the browser; Row Level Security protects the data.
# NEVER put the secret / service_role key in a VITE_ variable (it would be published to every visitor).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
